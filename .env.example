# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Hugging Face token, required only for GATED models
# (e.g. meta-llama/*, google/gemma-*, mistralai/Mistral-7B-Instruct-v0.2).
# Generate at: https://huggingface.co/settings/tokens
# NOT required for the default model in this repo (microsoft/Phi-3-mini-4k-instruct),
# which is public and ungated — you can leave this blank to start.
HUGGING_FACE_HUB_TOKEN=your_hf_token_here

# Optional: disable HF tokenizers parallelism warning in multi-worker DataLoaders
TOKENIZERS_PARALLELISM=false

# ---------------------------------------------------------------------------
# Experiment tracking is TensorBoard-only in this pipeline — fully local,
# no account, API key, or extra environment variables required. After
# training, view it with:
#   tensorboard --logdir outputs/checkpoints/runs --host 0.0.0.0
# ---------------------------------------------------------------------------
